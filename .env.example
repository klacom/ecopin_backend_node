# Existing environment variables
NODE_ENV=development
# Set DEPLOYMENT_ENV=production only on the production host, with NODE_ENV=production.
DEPLOYMENT_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001
CLASSIFIER_SERVICE_URL=http://127.0.0.1:8000
SPATIAL_FORECAST_SERVICE_URL=http://127.0.0.1:8001
MOBILE_REDIRECT_URL=ecopin://auth/callback
# Use keys from the isolated local Auth/Storage stack, never the hosted production project.
SUPABASE_URL=http://127.0.0.1:54321
# For an existing hosted DEVELOPMENT project only, designate that same origin here.
# DEVELOPMENT_SUPABASE_URL=https://your-development-project.supabase.co
# Server-Side Superadmin Secret Key (modern replacement for service_role key; keep strictly confidential)
SUPABASE_SECRET_KEY=your_supabase_secret_key
# Legacy alias fallback (deprecated, do not prefix with NEXT_PUBLIC in production)
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# NEXT_PUBLIC_SERVICE_ROLE_KEY=your_supabase_service_role_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# SMTP Email Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM_NAME="EcoPin App"
APP_BASE_URL=http://localhost:3000

# PDT-19: same random server-only secret on backend and spatial Python service.
# Never expose this through NEXT_PUBLIC_* or client bundles.
SPATIAL_ANALYTICS_TOKEN=

# PDT-23: activate after applying the escalation + baseline migrations (both applied to hosted DB); set true on the server and restart.
UNPROCESSED_ESCALATION_ENABLED=false
UNPROCESSED_ESCALATION_CRON=*/15 * * * *
