# Existing environment variables
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001
CLASSIFIER_SERVICE_URL=http://127.0.0.1:8000
SPATIAL_FORECAST_SERVICE_URL=http://127.0.0.1:8001
MOBILE_REDIRECT_URL=ecopin://auth/callback
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
# Server-Side Superadmin Secret Key (modern replacement for service_role key; keep strictly confidential)
SUPABASE_SECRET_KEY=your_supabase_secret_key
# Legacy alias fallback (deprecated, do not prefix with NEXT_PUBLIC in production)
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# NEXT_PUBLIC_SERVICE_ROLE_KEY=your_supabase_service_role_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# SMTP Email Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM_NAME="EcoPin App"
APP_BASE_URL=http://localhost:3000

# PDT-19: same random server-only secret on backend and spatial Python service.
# Never expose this through NEXT_PUBLIC_* or client bundles.
SPATIAL_ANALYTICS_TOKEN=

# PDT-23: activate only after applying the unprocessed-report escalation migration.
UNPROCESSED_ESCALATION_ENABLED=false
UNPROCESSED_ESCALATION_CRON=*/15 * * * *
